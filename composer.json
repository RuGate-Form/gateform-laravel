{
    "name": "gateform/laravel",
    "description": "Интеграция GateForm с Laravel: правило валидации, middleware, Blade-компоненты и виджеты формы, отзывов и связи.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "gateform",
        "captcha",
        "spam",
        "form-protection",
        "reviews",
        "blade"
    ],
    "homepage": "https://gateform.ru",
    "authors": [
        {
            "name": "GateForm",
            "homepage": "https://gateform.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/RuGate-Form/gateform-laravel/issues",
        "source": "https://github.com/RuGate-Form/gateform-laravel"
    },
    "require": {
        "php": ">=8.1",
        "gateform/sdk": "^1.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "GateForm\\Laravel\\": "src/"
        }
    },
    "suggest": {
        "laravel/framework": "Для полноценной работы Service Provider, Blade-компонентов и middleware"
    },
    "extra": {
        "laravel": {
            "providers": [
                "GateForm\\Laravel\\GateFormServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "lint": "php tests/lint.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
